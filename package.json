{
  "name": "audio-scope",
  "displayName": "Audio Scope",
  "version": "0.1.0",
  "description": "A real oscilloscope for any tab: triggered CRT trace, X-Y stereo field, spectrum analyzer and waterfall.",
  "author": "Bruce Blay <bruceblay@gmail.com>",
  "license": "ISC",
  "private": true,
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:dsp && npm run test:cymatics && npm run test:sand && npm run test:analyzer && npm run test:meters && npm run test:fx && npm run test:synth && npm run test:ui",
    "test:dsp": "esbuild test/dsp.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/dsp.test.mjs && node node_modules/.cache/dsp.test.mjs",
    "test:cymatics": "esbuild test/cymatics.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/cymatics.test.mjs && node node_modules/.cache/cymatics.test.mjs",
    "test:sand": "esbuild test/sand.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sand.test.mjs && node node_modules/.cache/sand.test.mjs",
    "test:analyzer": "esbuild test/analyzer.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/analyzer.test.mjs && node node_modules/.cache/analyzer.test.mjs",
    "test:meters": "esbuild test/meters.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/meters.test.mjs && node node_modules/.cache/meters.test.mjs",
    "test:fx": "esbuild test/fx.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fx.test.mjs && node node_modules/.cache/fx.test.mjs",
    "test:fx-browser": "node scripts/test-fx-browser.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:synth": "esbuild test/synth.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/synth.test.mjs && node node_modules/.cache/synth.test.mjs",
    "test:ui": "esbuild test/ui.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ui.test.mjs && node node_modules/.cache/ui.test.mjs",
    "package": "npm run build && rm -f audio-scope-v${npm_package_version}.zip && (cd dist && zip -rq ../audio-scope-v${npm_package_version}.zip . -x '*.DS_Store')"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
