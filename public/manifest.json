{
  "manifest_version": 3,
  "name": "Audio Scope",
  "version": "0.1.0",
  "description": "A real oscilloscope for any tab: triggered CRT trace, X-Y stereo field, spectrum analyzer and waterfall.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Audio Scope",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
